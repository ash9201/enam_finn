{
  "name": "finn-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test:browser": "node scripts/verify-foundation.mjs",
    "test:layout": "node scripts/verify-layout.mjs",
    "test:briefing": "node scripts/verify-briefing.mjs",
    "test:briefing:model": "node --test scripts/briefing-model.test.mjs scripts/event-reviews.test.mjs",
    "test:company-search": "node --test scripts/company-search.test.mjs",
    "test:company-selection": "node scripts/verify-company-selection.mjs",
    "test:portfolio:model": "node --test scripts/portfolio-model.test.mjs",
    "test:portfolio": "node scripts/verify-portfolio.mjs",
    "test:research-redesign": "node scripts/verify-research-redesign.mjs",
    "test:product": "node scripts/verify-product.mjs",
    "test:prices": "node scripts/verify-price-sources.mjs",
    "test:theme": "node scripts/verify-theme.mjs",
    "test:evidence": "node scripts/verify-evidence.mjs",
    "test:financial": "node scripts/verify-financial-results.mjs",
    "test:research-experience": "node scripts/verify-research-experience.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
