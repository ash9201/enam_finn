# Copy to .env.local. Never commit real credentials or paste them into chat.
# Read by the feasibility CLI and API from the workspace root.
FINN_ENV=development
GEMINI_API_KEY=
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.8-flash
# Hybrid retrieval is opt-in after migrations/backfill; see docs/HYBRID_RETRIEVAL.md.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
FINN_ENABLE_SEMANTIC_SEARCH=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Also accepted: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# or legacy SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY.
# A secret must NEVER have NEXT_PUBLIC_ or VITE_ prefixes.
SUPABASE_STORAGE_BUCKET=finn-documents
# Exact public frontend origin after deployment; comma-separated for multiple origins.
FINN_ALLOWED_ORIGINS=http://localhost:5173
# Optional; only needed to verify a deployment, not to run source/model probes.
FINN_DEPLOYED_API_URL=
FINN_DEPLOYED_WEB_URL=
# Frontend build variables are public. Never put privileged keys behind VITE_.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
# Vite also derives these two public values from the Supabase variables above.
VITE_SUPABASE_PUBLISHABLE_KEY=
